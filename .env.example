# SentinelStack Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# GRAFANA CONFIGURATION
# ========================================
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
GRAFANA_ROOT_URL=http://your-monitoring-server-ip:3000

# ========================================
# PROMETHEUS CONFIGURATION
# ========================================
PROMETHEUS_PORT=9090

# ========================================
# ALERTMANAGER CONFIGURATION
# ========================================
ALERTMANAGER_PORT=9093

# ========================================
# LOKI CONFIGURATION (Log Management)
# ========================================
LOKI_PORT=3100

# ========================================
# UPTIME KUMA CONFIGURATION
# ========================================
UPTIME_KUMA_PORT=3001

# ========================================
# EXPORTERS CONFIGURATION
# ========================================
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080
PVE_EXPORTER_PORT=9221

# ========================================
# PROXMOX CLUSTER CONFIGURATION
# ========================================
# Proxmox Node 1
PVE_NODE1_HOSTNAME=proxmox-node-1
PVE_NODE1_IP=192.168.1.10

# Proxmox Node 2
PVE_NODE2_HOSTNAME=proxmox-node-2
PVE_NODE2_IP=192.168.1.11

# Proxmox API Credentials
# Use root@pam or create a dedicated monitoring user
PVE_USER=root@pam
PVE_PASSWORD=YOUR_PROXMOX_PASSWORD
PVE_VERIFY_SSL=false

# ========================================
# DOKPLOY SERVER CONFIGURATION
# ========================================
DOKPLOY_HOSTNAME=dokploy-server
DOKPLOY_IP=192.168.1.20

# ========================================
# TELEGRAM ALERTING CONFIGURATION
# ========================================
# Create a bot via @BotFather and get the token
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Get your Chat ID by messaging @userinfobot
TELEGRAM_CHAT_ID=-1001234567890

# ========================================
# REMOTE NODES (For Prometheus Scrape Targets)
# ========================================
# Format: IP:PORT for each remote node exporter
# Comma-separated for multiple nodes
REMOTE_NODE_EXPORTERS=192.168.1.10:9100,192.168.1.11:9100,192.168.1.20:9100
REMOTE_CADVISOR=192.168.1.20:8080
