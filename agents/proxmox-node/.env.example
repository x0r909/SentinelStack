# SentinelStack Agent - Proxmox Node
# Copy this file to .env and fill in your values

# Node Exporter Port (must be accessible from monitoring server)
NODE_EXPORTER_PORT=9100

# Loki server address (monitoring server IP + port)
LOKI_URL=http://MONITORING_SERVER_IP:3100/loki/api/v1/push

# This node's hostname (for log identification)
NODE_HOSTNAME=proxmox-node-1
